{
  "info": {
    "name": "ЛР5 — расчёт премий и валидация",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Запустить оба сервиса: bun run dev:service2 (8084), bun run dev (8082). ЛР5: POST /api/v4/feedback. Годовая формула из методички; квартальная принята annualBonus / 4 только для руководителей. year необязателен. Для DEV/HR quarterlyBonus = null. Проверки unit-тестов: bun test tests/lab5-bonus.test.ts."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082"
    }
  ],
  "item": [
    {
      "name": "ЛР5 — HR, обычный год (пример методички)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"uid\": \"message-5\",\n  \"operationUid\": \"operation-5\",\n  \"systemName\": \"CRM\",\n  \"systemTime\": \"2026-10-28T12:00:00.000Z\",\n  \"source\": \"Postman\",\n  \"communicationId\": 100,\n  \"templateId\": 8,\n  \"productCode\": 1500,\n  \"smsCode\": 10,\n  \"position\": \"HR\",\n  \"salary\": 100000,\n  \"bonus\": 2,\n  \"workDays\": 243,\n  \"year\": 2023\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v4/feedback",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v4",
            "feedback"
          ]
        },
        "description": "Ожидается успешный расчёт после пересылки в Сервис 2."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Результат', function () { pm.expect(pm.response.json().code).to.eql('success'); });",
              "pm.test('Код ошибки', function () { pm.expect(pm.response.json().errorCode).to.eql(''); });",
              "pm.test('uid сохранён', function () { pm.expect(pm.response.json().uid).to.eql('message-5'); });",
              "pm.test('operationUid сохранён', function () { pm.expect(pm.response.json().operationUid).to.eql('operation-5'); });",
              "pm.test('Время ответа заполнено', function () { pm.expect(Number.isNaN(Date.parse(pm.response.json().systemTime))).to.eql(false); });",
              "pm.test('Годовая премия', function () { const expected = 360493.8271604938; pm.expect(Math.abs(pm.response.json().annualBonus - expected) < 0.000001).to.eql(true); });",
              "pm.test('Квартальная премия не положена', function () { pm.expect(pm.response.json().quarterlyBonus).to.eql(null); });"
            ]
          }
        }
      ]
    },
