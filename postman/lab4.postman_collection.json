    {
      "name": "ЛР4 — проверка времени по заголовку",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-service1-received-at",
            "value": "{{service1ReceivedAt}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"uid\": \"message-4\",\n  \"operationUid\": \"operation-4\",\n  \"systemName\": \"CRM\",\n  \"systemTime\": \"2026-10-28T12:00:00.000Z\",\n  \"source\": \"Postman\",\n  \"communicationId\": 100,\n  \"templateId\": 8,\n  \"productCode\": 1500,\n  \"smsCode\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{service2Url}}/api/v3/feedback",
          "host": [
            "{{service2Url}}"
          ],
          "path": [
            "api",
            "v3",
            "feedback"
          ]
        },
        "description": "Учебная метка установлена на 1 секунду раньше отправки: в логах Сервиса 2 ожидается Transfer time не менее 1000 ms. systemTime в JSON не участвует в измерении."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('service1ReceivedAt', String(Date.now() - 1000));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP status', function () { pm.response.to.have.status(200); });",
              "pm.test('Код результата', function () { pm.expect(pm.response.json().code).to.eql('success'); });",
              "pm.test('Код ошибки', function () { pm.expect(pm.response.json().errorCode).to.eql(''); });",
              "pm.test('uid сохранён', function () { pm.expect(pm.response.json().uid).to.eql(\"message-4\"); });",
              "pm.test('operationUid сохранён', function () { pm.expect(pm.response.json().operationUid).to.eql('operation-4'); });",
              "pm.test('systemTime заполнен', function () { pm.expect(Number.isNaN(Date.parse(pm.response.json().systemTime))).to.eql(false); });"
            ]
          }
        }
      ]
    },
