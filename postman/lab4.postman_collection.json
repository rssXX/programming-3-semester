              "pm.test('uid сохранён', function () { pm.expect(pm.response.json().uid).to.eql(\"message-4\"); });",
              "pm.test('operationUid сохранён', function () { pm.expect(pm.response.json().operationUid).to.eql('operation-4'); });",
              "pm.test('systemTime заполнен', function () { pm.expect(Number.isNaN(Date.parse(pm.response.json().systemTime))).to.eql(false); });"
