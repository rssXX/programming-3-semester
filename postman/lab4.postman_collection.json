{
  "info": {
    "name": "ЛР4 — два REST-сервиса",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Bun + TypeScript + Elysia. Запустить Сервис 2 на 8084 и Сервис 1 на 8082. /api/v3/feedback — ЛР4, /api/v2/feedback — ЛР2–3. Изменённый запрос и время передачи проверяются в логах Сервиса 2. Время начинается при получении запроса Сервисом 1."
  },
  "variable": [
    {
      "key": "service1Url",
      "value": "http://localhost:8082"
    },
    {
      "key": "service2Url",
      "value": "http://localhost:8084"
    }
  ],
  "item": [
    {
      "name": "ЛР4 — запрос через Сервис 1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"uid\": \"message-4\",\n  \"operationUid\": \"operation-4\",\n  \"systemName\": \"CRM\",\n  \"systemTime\": \"2026-10-28T12:00:00.000Z\",\n  \"source\": \"Postman\",\n  \"communicationId\": 100,\n  \"templateId\": 8,\n  \"productCode\": 1500,\n  \"smsCode\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{service1Url}}/api/v3/feedback",
          "host": [
            "{{service1Url}}"
          ],
          "path": [
            "api",
            "v3",
            "feedback"
          ]
        },
        "description": "В логах Сервиса 1: CRM / Postman. В логах Сервиса 2: ERP / Service 1, остальные поля без изменений. Далее строка Transfer time с uid и operationUid. Сервис 1 отвечает после успешного ответа Сервиса 2."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP status', function () { pm.response.to.have.status(200); });",
              "pm.test('Код результата', function () { pm.expect(pm.response.json().code).to.eql('success'); });",
              "pm.test('Код ошибки', function () { pm.expect(pm.response.json().errorCode).to.eql(''); });",
              "pm.test('uid сохранён', function () { pm.expect(pm.response.json().uid).to.eql(\"message-4\"); });",
              "pm.test('operationUid сохранён', function () { pm.expect(pm.response.json().operationUid).to.eql('operation-4'); });",
              "pm.test('systemTime заполнен', function () { pm.expect(Number.isNaN(Date.parse(pm.response.json().systemTime))).to.eql(false); });"
            ]
          }
        }
      ]
    },
