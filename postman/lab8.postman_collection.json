        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "const rows = pm.response.text().match(/<tr>[\\s\\S]*?<\\/tr>/g) || [];",
              "const row = rows.find(function (value) { return value.includes(pm.collectionVariables.get('lab8StudentSurname')); });",
              "pm.test('Созданный студент в списке', function () { pm.expect(Boolean(row)).to.eql(true); });",
              "const match = row && row.match(/studentId=(\\d+)/);",
              "if (match) pm.collectionVariables.set('lab8StudentId', match[1]);"
            ]
          }
        }
      ]
