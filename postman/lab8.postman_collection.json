      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/lab8/register"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('lab8Email', 'lab8-' + Date.now() + '-' + Math.random().toString(16).slice(2) + '@example.test');",
              "pm.collectionVariables.set('lab8StudentSurname', 'Postman-' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
