{
  "info": {
    "name": "ЛР8 — регистрация, вход, роли и студенты",
    "description": "Выполнять сверху вниз в Collection Runner с включённой cookie jar. Перенаправления в запросах выключены для проверки статусов 303. CSRF извлекается из HTML, email генерируется заново. Сценарий удаляет только созданного им студента; учебный аккаунт остаётся в БД. Сервис 2 и скриншоты не требуются.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "lab8Csrf",
      "value": "",
      "type": "string"
    },
    {
      "key": "lab8Email",
      "value": "",
      "type": "string"
    },
    {
      "key": "lab8StudentSurname",
      "value": "",
      "type": "string"
    },
    {
      "key": "lab8StudentId",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const csrf = pm.response.text().match(/name=\"_csrf\" value=\"([a-f0-9]{64})\"/);",
          "if (csrf) pm.collectionVariables.set('lab8Csrf', csrf[1]);",
          "pm.test('Пароль не возвращается в HTML', function () { pm.expect(pm.response.text().includes('Study-password-8!')).to.eql(false); });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01. Публичная главная",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/lab8"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02. Аноним направляется на вход",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/lab8/list"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 303', function () { pm.response.to.have.status(303); });",
              "pm.test('Перенаправление на вход', function () { pm.expect(pm.response.headers.get('Location')).to.eql('/lab8/login'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03. Форма регистрации и CSRF",
      "protocolProfileBehavior": {
        "followRedirects": false
